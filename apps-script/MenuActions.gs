/** Category submenus apply the current selection without opening a modal. */
function directPlaceAction_(action,type){try{const c=shareSelection_(100);if(c.ids.length>100)throw new Error('Select at most 100 items.');if(c.tab===PIPE.PLACES&&action!=='return')throw new Error('Select event rows first.');const payload={action,tab:c.tab,placeType:type,items:c.ids.map(id=>({id,title:id,version:bulkVersion_(id,c.tab)}))};const r=saveBulkActions(payload);SpreadsheetApp.getActiveSpreadsheet().toast(r.count+' entries '+(action==='copy'?'copied':action==='return'?'returned':'moved')+'.','Events',5);}catch(e){SpreadsheetApp.getUi().alert(e.message);}}
function moveActivities(){directPlaceAction_('move','activity')}function moveExperiences(){directPlaceAction_('move','experience')}function moveCourses(){directPlaceAction_('move','course')}function moveRecurring(){directPlaceAction_('move','recurring_event')}function moveAttractions(){directPlaceAction_('move','attraction')}function moveDayTrips(){directPlaceAction_('move','day_trip')}function moveRestaurants(){directPlaceAction_('move','restaurant')}
function copyActivities(){directPlaceAction_('copy','activity')}function copyExperiences(){directPlaceAction_('copy','experience')}function copyCourses(){directPlaceAction_('copy','course')}function copyRecurring(){directPlaceAction_('copy','recurring_event')}function copyAttractions(){directPlaceAction_('copy','attraction')}function copyDayTrips(){directPlaceAction_('copy','day_trip')}function copyRestaurants(){directPlaceAction_('copy','restaurant')}
function returnSelectedToEvents(){directPlaceAction_('return','')}
function removeSelectedEntries(){
 const ui=SpreadsheetApp.getUi();let c;try{c=shareSelection_(100);}catch(e){ui.alert(e.message);return;}
 if(ui.alert('Move to Trash?','Remove '+c.ids.length+' selected listings, their linked activity copies, and their public versions? Original screenshots are kept. You can restore the records from Trash.',ui.ButtonSet.OK_CANCEL)!==ui.Button.OK)return;
 const lock=LockService.getScriptLock();lock.waitLock(20000);
 try{sharingTables_();const raw=vrRows_(PIPE.RAW),records=visualEventRows_(),places=vrRows_(PIPE.PLACES),trash=readObjects_(table_(SHARING.TRASH,SHARING.TRASH_HEADERS)),states=readObjects_(table_(SHARING.STATE,SHARING.STATE_HEADERS));
 const snapshots=c.ids.map(id=>{if(trash.some(r=>String(r.group_id)===id))throw new Error('Entry already in Trash.');const members=raw.filter(r=>String(r.group_id)===id);if(!members.length)throw new Error('Source record no longer exists.');const record=records.find(r=>String(r.group_id)===id),place=places.find(r=>String(r.group_id)===id);return {id,title:(record||place||members[0]).title,snapshot:{record,place,states:members.map(r=>({id:String(r.id),status:r.status,match_status:r.match_status,review_reason:r.review_reason,suggested_group_id:r.suggested_group_id}))}};});
 snapshots.forEach(x=>{if(JSON.stringify(x.snapshot).length>45000)throw new Error('Record is too large for safe Trash storage.');});
 const published=states.filter(r=>c.ids.includes(String(r.group_id)));if(published.length)publicRequest_({action:'remove',ids:published.map(r=>r.listing_id)});
 const sh=table_(SHARING.TRASH,SHARING.TRASH_HEADERS);snapshots.forEach(x=>{sh.appendRow([x.id,x.title,new Date().toISOString(),JSON.stringify(x.snapshot)]);raw.filter(r=>String(r.group_id)===x.id).forEach(r=>vrUpdateRow_(PIPE.RAW,r._row,{status:CONFIG.STATUS.REJECTED,match_status:'trash',review_reason:'Removed to Trash',suggested_group_id:''}));});
 places.filter(r=>c.ids.includes(String(r.group_id))).sort((a,b)=>b._row-a._row).forEach(r=>table_(PIPE.PLACES,PIPE.PLACE_HEADERS).deleteRow(r._row));published.sort((a,b)=>b._row-a._row).forEach(r=>table_(SHARING.STATE,SHARING.STATE_HEADERS).deleteRow(r._row));refreshEventViews_();SpreadsheetApp.getActiveSpreadsheet().toast(c.ids.length+' listings moved to Trash.','Events',6);
 }catch(e){ui.alert(e.message);}finally{lock.releaseLock();}
}
function restoreSelectedTrash(){
 const lock=LockService.getScriptLock();lock.waitLock(20000);try{const ss=SpreadsheetApp.getActiveSpreadsheet(),sh=ss.getActiveSheet();if(sh.getName()!==SHARING.TRASH)throw new Error('Select rows in the Trash tab first.');const list=ss.getActiveRangeList(),ids=selectionGroupIds_(sh,list?list.getRanges():[ss.getActiveRange()].filter(Boolean));if(!ids.length||ids.length>100)throw new Error('Select 1–100 Trash rows.');const rows=readObjects_(sh).filter(r=>ids.includes(String(r.group_id))),raw=vrRows_(PIPE.RAW),places=vrRows_(PIPE.PLACES);
 const plans=rows.map(r=>{const s=JSON.parse(r.snapshot_json);if(s.states.some(old=>!raw.some(x=>String(x.id)===old.id&&x.match_status==='trash')))throw new Error('An entry changed since removal. Restore blocked.');if(s.place&&places.some(x=>String(x.group_id)===String(r.group_id)))throw new Error('Activity entry already exists.');return {r,s};});
 plans.forEach(({r,s})=>{if(s.record)writeEventRecord_(s.record);if(s.place){const p=table_(PIPE.PLACES,PIPE.PLACE_HEADERS);p.appendRow(PIPE.PLACE_HEADERS.map(k=>nativeEventCell_(k,s.place[k]||'')));}s.states.forEach(old=>{const current=raw.find(x=>String(x.id)===old.id);const patch=Object.assign({},old);delete patch.id;vrUpdateRow_(PIPE.RAW,current._row,patch);});raw.filter(x=>String(x.group_id)===String(r.group_id)&&x.match_status==='trash'&&!s.states.some(old=>old.id===String(x.id))).forEach(x=>{const old=s.states[0];vrUpdateRow_(PIPE.RAW,x._row,{status:old.status,match_status:old.match_status,review_reason:old.review_reason,suggested_group_id:old.suggested_group_id});});});rows.sort((a,b)=>b._row-a._row).forEach(r=>sh.deleteRow(r._row));refreshEventViews_();ss.toast(rows.length+' restored. Eligible posters will publish automatically.','Events',7);
 }catch(e){SpreadsheetApp.getUi().alert(e.message);}finally{lock.releaseLock();}
}
